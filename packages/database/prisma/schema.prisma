generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REPORTER
  AGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           UserRole

  // Relations
  reportedTickets Ticket[]  @relation("Reporter")
  assignedTickets Ticket[]  @relation("Assignee")
  comments        Comment[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Ticket {
  id                 String       @id @default(cuid())
  title              String
  description        String
  priority           Priority
  status             TicketStatus @default(OPEN)

  // Relations
  reporterId         String
  reporter           User         @relation("Reporter", fields: [reporterId], references: [id])
  assigneeId         String?
  assignee           User?        @relation("Assignee", fields: [assigneeId], references: [id])
  comments           Comment[]

  // SLA Timestamps (Computed at creation)
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime


  firstResponseAtRiskAt DateTime?
  resolutionAtRiskAt    DateTime?
  firstResponseBreached Boolean?
  resolutionBreached    Boolean?
  // SLA Actual Timestamps (Set when event occurs)
  firstResponseAt    DateTime?
  resolvedAt         DateTime?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Indexes for efficient pagination and filtering
  @@index([createdAt])
  @@index([status, priority])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  
  // Relations
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
}
